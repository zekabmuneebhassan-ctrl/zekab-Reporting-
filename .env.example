# ---- Supabase (client-safe) ----
# Project URL, e.g. https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# The "anon" public key. Safe to expose to the browser; RLS is what protects data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Supabase (server-only, NEVER expose to the browser) ----
# Service-role key. Used only by the import script and scheduled automation jobs.
# Bypasses RLS — keep it server-side only.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Import script ----
# Path to the workbook to import (defaults to the one in the repo root).
IMPORT_WORKBOOK_PATH=./Summary Gaming Apps.xlsx

# ================================================================
# Phase 7 automation (fill in only when wiring each integration up)
# ================================================================
# -- AdMob (revenue) — user-consent OAuth, no service account --
ADMOB_CLIENT_ID=
ADMOB_CLIENT_SECRET=
ADMOB_REFRESH_TOKEN=
ADMOB_PUBLISHER_ID=

# -- Google Play Console (installs/uninstalls/active users) via GCS export --
PLAY_GCS_BUCKET=
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# -- Google Ads (campaign spend) — secondary --
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Shared secret to protect cron endpoints (Vercel Cron / Supabase scheduler)
CRON_SECRET=
